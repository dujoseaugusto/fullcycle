# Rate Limiter Configuration

# Global IP Rate Limit (requests per second)
# Número máximo de requisições permitidas por segundo por IP
RATE_LIMITER_IP_LIMIT=5

# Global IP Block Duration (seconds)
# Tempo em segundos que um IP fica bloqueado após exceder o limite
RATE_LIMITER_IP_BLOCK_DURATION=300

# Enable/Disable token rate limiting (true/false)
# Se habilitado, permite limites diferentes para tokens de API
RATE_LIMITER_TOKEN_ENABLED=true

# Example token configuration (token:limit:block_duration)
# Formato: token1:limite1:duracao1;token2:limite2:duracao2
# Você pode adicionar múltiplos tokens separados por ponto-e-vírgula
# O limite de token sobrescreve o limite de IP
RATE_LIMITER_TOKENS=abc123:10:600;xyz789:20:900

# Redis Configuration
# Host e porta do Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Server Configuration
# Porta em que o servidor HTTP irá escutar
SERVER_PORT=8080

# ============================================
# EXEMPLOS DE CONFIGURAÇÃO
# ============================================

# Configuração 1: Limite básico por IP
# RATE_LIMITER_IP_LIMIT=10
# RATE_LIMITER_IP_BLOCK_DURATION=60
# RATE_LIMITER_TOKEN_ENABLED=false

# Configuração 2: Múltiplos tokens com diferentes limites
# RATE_LIMITER_IP_LIMIT=5
# RATE_LIMITER_IP_BLOCK_DURATION=300
# RATE_LIMITER_TOKEN_ENABLED=true
# RATE_LIMITER_TOKENS=free:10:600;premium:100:600;enterprise:1000:3600

# Configuração 3: Limite muito restritivo
# RATE_LIMITER_IP_LIMIT=1
# RATE_LIMITER_IP_BLOCK_DURATION=86400
# RATE_LIMITER_TOKEN_ENABLED=true
# RATE_LIMITER_TOKENS=api_token:100:3600

# Configuração 4: Docker Compose (redis como hostname)
# REDIS_HOST=redis
# REDIS_PORT=6379
